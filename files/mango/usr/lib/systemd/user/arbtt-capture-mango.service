[Unit]
Description=arbtt capture for MangoWM (ext-idle-notify-v1)
After=mango-session.target
PartOf=mango-session.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/arbtt-capture-mango
Restart=on-failure
RestartSec=5

[Install]
WantedBy=mango-session.target
